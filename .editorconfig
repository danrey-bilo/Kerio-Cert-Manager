# ⚠ Репозиторий хранит LF: без этого файла `dotnet format` на Windows требует CRLF.
# Стилевых правил намеренно нет, кроме лишних `using` (IDE0005).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Markdown значащими пробелами в конце строки задаёт перенос — срезать их нельзя.
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
dotnet_diagnostic.IDE0005.severity = warning

# Миграции генерирует `dotnet ef` — руками их не правят, стилевые правила к ним не относятся.
# Наборы миграций проекта и модулей.
[{KerioCertManager.Api/Schema/Migrations,KerioCertManager.Modules.KeyManager/Schema/Migrations,KerioCertManager.Modules.Kerio/Schema/Migrations}/*.cs]
generated_code = true

[*.{csproj,props,targets,slnx}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{ts,tsx,css,html}]
indent_size = 2
