# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env в git не попадает.

# Cloudflare Tunnel: COMPOSE_PROFILES=tunnel включает службу cloudflared при обычном
# `docker compose up -d`. Токен — НЕ здесь, а в файле секрета: ./scripts/set-tunnel-token.sh.
# Без туннеля — закомментируйте строку.
COMPOSE_PROFILES=tunnel

# Образ сервиса из Docker Hub. По умолчанию — версия этого выпуска; новая — сменой тега здесь.
# KCM_IMAGE=danreero/kerio_cert_manager:1.0.9

# Порт панели на 127.0.0.1, если 8001 на сервере уже занят.
# KCM_HTTP_PORT=18001

# Свой обратный прокси вместо туннеля или вместе с ним: адрес, с которого он приходит в контейнер.
# KCM_TRUSTED_PROXY_NETWORKS=172.18.0.1/32

# Подсеть сети туннеля, если 172.31.252.0/28 на сервере уже занята. Сменили подсеть — задайте внутри неё
# адрес cloudflared (ему одному API верит заголовки X-Forwarded-*) и диапазон выдачи остальным — без этого адреса.
# KCM_TUNNEL_SUBNET=172.31.252.0/28
# KCM_TUNNEL_PROXY_IP=172.31.252.2
# KCM_TUNNEL_RANGE=172.31.252.8/29
